{
  "name": "@workspace/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "convex dev",
    "deploy": "convex deploy",
    "test": "vitest run tests/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed:superadmin": "npx convex run auth:upsertSuperadmin \"{\\\"email\\\":\\\"$SEED_EMAIL\\\",\\\"password\\\":\\\"$SEED_PASSWORD\\\",\\\"name\\\":\\\"$SEED_NAME\\\"}\"",
    "seed:urbrands": "npx convex run tenants:seedUrbrands",
    "seed:urbrands:prompt": "npx convex run urbrands:seedUrbrandsPrompt",
    "seed:alcarbon:pqr-routing": "npx convex run tenants:ensureAlcarbonPqrRouting"
  },
  "dependencies": {
    "@ai-sdk/openai": "1.3.23",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@convex-dev/agent": "0.1.16",
    "@convex-dev/rag": "0.3.3",
    "ai": "4.3.19",
    "convex": "^1.31.2",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pdf-parse": "^1.1.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
